# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Playwright (Abschnitt 10.1) -- lokale Testartefakte, keine Quelldateien
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example
!.env*.example

# Python virtual environment
/venv/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.idea/
.vscode/
*.swp
*.swo

# Supabase
supabase/.branches
supabase/.temp

# Lokal entpackte, gepinnte Supabase-CLI (Binärdatei, nicht versioniert)
/tools/supabase-cli/

# OS
Thumbs.db

# Claude Code (lokale IDE-Einstellungen, nicht für GitHub)
.claude/

# MCP Server Konfiguration (persönlich, nicht für GitHub)
.mcp.json

# Legacy-Projekte (lokal als Referenz, nicht Teil des zap-v2 Repos)
ZAP/
legacy-bardhi/

# Migrationsnachweise: nur der bereinigte Bericht darf versioniert werden.
# Rohinventare und sämtliche übrigen lokalen Dokumente bleiben ausgeschlossen.
docs/*
!docs/migration-evidence/
docs/migration-evidence/*
!docs/migration-evidence/2026-07-18-supabase-baseline-inventory.md
!docs/migration-evidence/2026-07-29-baseline-adoption-decision.md
!docs/migration-evidence/2026-07-30-schritt12-verifikationsgate.md
docs/migration-evidence/private/

# Temporäre Prüfdateien der versionierten Designreferenzen
design-reference/_writetest.tmp

# graphify-generierter Knowledge Graph (lokal, nicht Teil des Repos)
graphify-out/

# Excel-Arbeitsdateien (Kursdaten/Kurspläne/Termine) -- bleiben lokal, nicht Teil des Repos
*.xlsx

# Word-/PDF-Arbeitsdokumente (Notizen, Planung, Dokumentationsentwürfe) -- bleiben lokal, nicht
# Teil des Repos, unabhängig vom Inhalt.
*.docx
*.pdf

# Office-Sperrdateien (temporäre Lock-Files bei geöffneten Word-/Excel-Dokumenten)
~$*
