# Environment Variables Template
# Copy this file to .env.local and fill in your values

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# NextAuth.js
AUTH_SECRET=your-auth-secret-min-32-chars

# Anthropic (für KI-gestützte Aufsatzkorrektur)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: Auth Providers
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# SEO (Abschnitt 10.4 des Architektur-Briefings)
# Absolute Basis-URL dieser Umgebung, für canonical-/OpenGraph-URLs und sitemap.xml.
NEXT_PUBLIC_APP_URL=https://your-domain.example
# Nur in der echten Produktionsumgebung auf 'true' setzen -- robots.ts sperrt sonst per
# Fail-closed-Default die gesamte Indexierung (schützt Staging/Preview-Deployments davor,
# versehentlich von Suchmaschinen erfasst zu werden).
NEXT_PUBLIC_ALLOW_INDEXING=false

# Feature-Flag/Cutover (Abschnitt 10.4 des Architektur-Briefings)
# Server-only Kill-Switch fuer die neuen lokalisierten Marketingrouten (/, /de/..., alle
# app/[locale]/(marketing)-Seiten). Default true, wenn die Variable fehlt oder einen anderen Wert
# als der exakte String "false" hat -- nur ein explizites "false" schaltet auf Rollback: proxy.ts
# leitet dann jede dieser Routen auf die weiterhin unveraendert funktionierende Bestandsroute
# /kurse um, app/sitemap.ts listet dann ebenfalls nur noch /kurse. Loescht/aendert keine Daten;
# siehe lib/marketing-flag.ts und runbook-marketing-cutover.md fuer Details und Rollback-Schritte.
# NICHT NEXT_PUBLIC_ -- der Schalter muss bereits in der Middleware greifen, nicht erst im Client-Bundle.
MARKETING_SITE_LIVE=true

# E-Mail-Outbox (Abschnitt 10.4 des Architektur-Briefings), siehe mail-outbox-runbook.md.
# Resend-API-Key. Ohne gesetzten Wert wirft lib/mail/resend-client.ts erst beim tatsaechlichen
# Sendeversuch einen Fehler (kein Absturz beim Prozessstart) -- die betroffene mail_outbox-Zeile
# wird dann als 'failed' markiert und spaeter automatisch erneut versucht.
RESEND_API_KEY=your-resend-api-key
# Absenderadresse. Platzhalter, bis eine echte Domain bei Resend verifiziert ist -- siehe
# mail-outbox-runbook.md "Offene Punkte, die eine Entscheidung von dir brauchen".
MAIL_FROM_ADDRESS=noreply@example.ch
# Optionale zusätzliche Empfänger für neue Kursanmeldungen (kommagetrennt). Admin-Profile mit
# hinterlegter E-Mail-Adresse werden automatisch ebenfalls benachrichtigt.
ADMIN_NOTIFICATION_EMAILS=admin@example.ch
# Geheimnis fuer POST /api/mail-outbox/process (externer Scheduler-Endpunkt). Fail-closed: ohne
# gesetzten Wert lehnt der Endpunkt jede Anfrage ab, es gibt keinen erratbaren Default.
MAIL_OUTBOX_CRON_SECRET=your-random-cron-secret
